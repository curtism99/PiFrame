{
  "name": "pi-picture-kiosk",
  "version": "0.1.0",
  "description": "Local-first Raspberry Pi picture frame and ambience kiosk.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "scan": "node scripts/scan-media.js",
    "check-media": "node scripts/check-media.js",
    "test:sync": "python3 -m unittest discover -s tests -p test_media_sync.py",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/traffic.browser.cjs",
    "test:deploy": "python3 -m unittest discover -s tests -p test_traffic_deploy.py"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
