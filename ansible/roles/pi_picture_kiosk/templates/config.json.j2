{
  "device_name": "{{ frame_device_name }}",
  "location": "{{ frame_location }}",
  "server": {
    "host": "{{ frame_server_host }}",
    "port": {{ frame_server_port }}
  },
  "media": {
    "root": "{{ frame_media_root }}",
    "asset_base_dir": "media",
    "fallback_dirs": {
      "slideshow": ["media/photos"]
    },
    "allowed_image_extensions": [".jpg", ".jpeg", ".png", ".webp"]
  },
  "playlists": {
    "slideshow": "playlists/slideshow.json"
  },
  "display": {
    "orientation": "landscape",
    "mode": "slideshow",
    "hide_cursor": {{ frame_hide_cursor | default(true) | bool | lower }},
    "cursor_idle_seconds": {{ frame_cursor_idle_seconds | default(3) }},
    "transition_seconds": 3
  },
  "slideshow": {
    "photo_duration_seconds": 20,
    "shuffle": true,
    "image_fit": "smart-frame",
    "show_filename": false,
    "transition_effects": {
      "enabled": true,
      "style": "random",
      "effects": ["fade", "dissolve", "dip"]
    }
  },
  "clock": {
    "enabled": {{ frame_clock_enabled | bool | lower }},
    "format": "12h",
    "show_date": true,
    "position": "{{ frame_clock_position | default('bottom-right') }}"
  },
  "widgets": {
    "weather": {
      "enabled": {{ frame_weather_enabled | default(true) | bool | lower }},
      "provider": "nws",
      "position": "{{ frame_weather_position | default('bottom-left') }}",
      "latitude": {{ frame_weather_latitude | default(40.6892) }},
      "longitude": {{ frame_weather_longitude | default(-74.0445) }},
      "units": "{{ frame_weather_units | default('fahrenheit') }}",
      "refresh_minutes": {{ frame_weather_refresh_minutes | default(10) }},
      "stale_after_minutes": {{ frame_weather_stale_after_minutes | default(90) }},
      "forecast_cycle_seconds": {{ frame_weather_forecast_cycle_seconds | default(25) }},
      "max_alerts": {{ frame_weather_max_alerts | default(3) }},
      "user_agent": "{{ frame_weather_user_agent | default('PiFrame/' ~ frame_device_name) }}",
      "test_alerts": {
        "enabled": {{ frame_weather_test_alerts_enabled | default(false) | bool | lower }}
      }
    }
  },
  "nas_sync": {
    "enabled": true,
    "method": "smb-rsync",
    "source": "{{ frame_nas_source }}",
    "source_subdir": "{{ frame_nas_source_subdir | default('') }}",
    "mount_point": "{{ frame_nas_mount_point }}",
    "local_cache": "{{ frame_media_root }}",
    "sync_interval_minutes": {{ frame_sync_interval_minutes }},
    "credentials_file": "{{ frame_nas_credentials_file }}",
    "script_path": "{{ frame_app_dir }}/scripts/sync-from-nas.sh"
  },
  "runtime_state": {
    "path": "{{ frame_state_dir }}/state.json"
  }
}
