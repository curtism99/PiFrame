#!/usr/bin/env bash
set -euo pipefail

NAS_SOURCE="${PIFRAME_NAS_SOURCE:-{{ frame_nas_source }}}"
NAS_SOURCE_SUBDIR="${PIFRAME_NAS_SOURCE_SUBDIR:-{{ frame_nas_source_subdir | default('') }}}"
NAS_PHOTO_SUBDIR="${PIFRAME_NAS_PHOTO_SUBDIR:-{{ frame_nas_photo_subdir | default('media/photos') }}}"
MOUNT_POINT="${PIFRAME_NAS_MOUNT_POINT:-{{ frame_nas_mount_point }}}"
LOCAL_CACHE="${PIFRAME_LOCAL_CACHE:-{{ frame_media_root }}}"
CREDENTIALS_FILE="${PIFRAME_CREDENTIALS_FILE:-{{ frame_nas_credentials_file }}}"
STATE_FILE="${PIFRAME_STATE_FILE:-{{ frame_state_dir }}/state.json}"
LOG_FILE="${PIFRAME_SYNC_LOG:-/var/log/piframe-media-sync.log}"
MIN_FREE_BYTES="${PIFRAME_MIN_FREE_BYTES:-{{ frame_sync_min_free_bytes | default(1073741824) }}}"
NAS_HOST="${NAS_SOURCE#//}"
NAS_HOST="${NAS_HOST%%/*}"

log() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" | tee -a "$LOG_FILE"
}

is_ip_address() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

mkdir -p "$MOUNT_POINT" "$LOCAL_CACHE" "$(dirname "$STATE_FILE")"

if [[ "$NAS_SOURCE_SUBDIR" = /* || "$NAS_SOURCE_SUBDIR" == *".."* ]]; then
  log "Invalid NAS source subdir: $NAS_SOURCE_SUBDIR"
  exit 24
fi

if [[ -z "$NAS_PHOTO_SUBDIR" || "$NAS_PHOTO_SUBDIR" = /* || "$NAS_PHOTO_SUBDIR" == *".."* ]]; then
  log "Invalid NAS photo subdir: $NAS_PHOTO_SUBDIR"
  exit 24
fi

if [[ ! "$MIN_FREE_BYTES" =~ ^[0-9]+$ ]]; then
  log "Invalid minimum free byte reserve: $MIN_FREE_BYTES"
  exit 24
fi

if ! mountpoint -q "$MOUNT_POINT"; then
  if ! is_ip_address "$NAS_HOST" && ! getent hosts "$NAS_HOST" >/dev/null; then
    log "NAS host '$NAS_HOST' does not resolve on this Pi. Add an /etc/hosts entry or use an IP-based source such as //192.168.0.10/PiFrame-Media."
    exit 23
  fi

  if [[ ! -f "$CREDENTIALS_FILE" ]]; then
    log "SMB credentials file missing: $CREDENTIALS_FILE"
    exit 20
  fi

  log "Mounting $NAS_SOURCE at $MOUNT_POINT"
  if ! mount -t cifs "$NAS_SOURCE" "$MOUNT_POINT" \
    -o "credentials=$CREDENTIALS_FILE,iocharset=utf8,vers=3.0,uid=$(id -u {{ frame_kiosk_user }}),gid=$(id -g {{ frame_kiosk_user }}),file_mode=0644,dir_mode=0755"; then
    log "Mount failed for $NAS_SOURCE. If this was mount error(2), verify the SMB share name. The NAS source must be the share root, for example //nas-ds223/PiFrame-Media, with office configured as the source subdir."
    exit 25
  fi
fi

if ! mountpoint -q "$MOUNT_POINT"; then
  log "NAS source is not mounted. Refusing to run rsync --delete-after."
  exit 21
fi

SYNC_SOURCE="$MOUNT_POINT"
if [[ -n "$NAS_SOURCE_SUBDIR" ]]; then
  SYNC_SOURCE="$MOUNT_POINT/$NAS_SOURCE_SUBDIR"
fi

if [[ ! -d "$SYNC_SOURCE" ]]; then
  log "Mounted source directory is unavailable: $SYNC_SOURCE"
  exit 22
fi

PHOTO_SOURCE="$SYNC_SOURCE/$NAS_PHOTO_SUBDIR"
PHOTO_CACHE="$LOCAL_CACHE/media/photos"

if [[ ! -d "$PHOTO_SOURCE" ]]; then
  log "Mounted photo source directory is unavailable: $PHOTO_SOURCE"
  exit 22
fi

mkdir -p "$PHOTO_CACHE"

SOURCE_BYTES="$(
  find "$PHOTO_SOURCE" -type f \( \
    -iname '*.jpg' -o \
    -iname '*.jpeg' -o \
    -iname '*.png' -o \
    -iname '*.webp' \
  \) -printf '%s\n' | awk '{ total += $1 } END { printf "%.0f\n", total }'
)"
CACHE_BYTES="$(du -sb "$PHOTO_CACHE" | awk '{ print $1 }')"
AVAILABLE_BYTES="$(df -PB1 "$LOCAL_CACHE" | awk 'NR == 2 { print $4 }')"

if (( SOURCE_BYTES + MIN_FREE_BYTES > AVAILABLE_BYTES + CACHE_BYTES )); then
  log "Photo sync refused: source requires $SOURCE_BYTES bytes and the cache must retain $MIN_FREE_BYTES free bytes; cache has $CACHE_BYTES bytes and $AVAILABLE_BYTES bytes are available."
  exit 28
fi

log "Starting photo-only rsync from $PHOTO_SOURCE/ to $PHOTO_CACHE/"
log "Photo cache preflight: source=$SOURCE_BYTES bytes cache=$CACHE_BYTES bytes available=$AVAILABLE_BYTES bytes reserve=$MIN_FREE_BYTES bytes"
set +e
rsync \
  -rlt \
  --human-readable \
  --stats \
  --delete-after \
  --delete-excluded \
  --no-owner \
  --no-group \
  --no-perms \
  --omit-dir-times \
  --include='*/' \
  --include='*.[jJ][pP][gG]' \
  --include='*.[jJ][pP][eE][gG]' \
  --include='*.[pP][nN][gG]' \
  --include='*.[wW][eE][bB][pP]' \
  --exclude='*' \
  "$PHOTO_SOURCE"/ "$PHOTO_CACHE"/ 2>&1 | tee -a "$LOG_FILE"
rsync_status=${PIPESTATUS[0]}
set -e

if [[ "$rsync_status" -eq 24 ]]; then
  log "rsync reported vanished files during transfer; treating as non-fatal for this media cache."
elif [[ "$rsync_status" -ne 0 ]]; then
  log "rsync failed with exit status $rsync_status. See $LOG_FILE for the file-level error above."
  exit "$rsync_status"
fi

PIFRAME_STATE_FILE="$STATE_FILE" node -e '
const fs = require("fs");
const file = process.env.PIFRAME_STATE_FILE;
let state = {};
try { state = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}
state.last_sync = new Date().toISOString();
state.updated_at = state.last_sync;
fs.writeFileSync(file, JSON.stringify(state, null, 2));
' || true

log "Sync complete"
