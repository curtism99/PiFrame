[Unit]
Description=Pi Picture Kiosk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piframe
Group=piframe
WorkingDirectory=/opt/pi-picture-kiosk
Environment=NODE_ENV=production
Environment=PIFRAME_CONFIG_PATH=/etc/pi-picture-kiosk/config.json
ExecStart=/usr/bin/node server/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
